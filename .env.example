# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Your own Anthropic key. The engine is tuned for Claude and uses its web search tool.
# Without it the engine can still fact check with the rule-based judge, but it cannot research or write.
ANTHROPIC_API_KEY=

# Passwords for the bundled Postgres. Pick long random values (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me-postgres
PAPERBOY_DB_PASSWORD=change-me-app-role

# Signs OAuth state and email links. At least 24 characters (for example: openssl rand -hex 24).
APP_SECRET=change-me-to-a-long-random-string

# The operator account (the one person who logs the CLI in on a self-host).
PAPERBOY_ADMIN_EMAIL=you@example.com
PAPERBOY_ADMIN_PASSWORD=change-me-admin

# Where the server is reachable. Used in links and the Google OAuth redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------
# Search Console. Create your own Google OAuth client (Web application) and add
# ${NEXT_PUBLIC_APP_URL}/api/gsc/callback as an authorized redirect URI. Scope used: webmasters.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Report emails (https://resend.com). Without a key, emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM=Paperboy <reports@your-domain.example>

# Pacing. Articles per site per week that the worker starts on its own. 0 means only when you ask (paperboy write):
# nothing is spent on your Anthropic key until you run it. Set 3 (or more) to let the worker write on a schedule.
# Unset, a site's plan decides (starter 3, growth 7, pro 14).
# Per-article cost caps (6 web searches, 1.50 USD, 600,000 tokens) live in packages/engine/src/config/models.ts.
PAPERBOY_ARTICLES_PER_WEEK=0

# What happens to an article that passes the fact check. Default: it waits for `paperboy publish <article-id>`.
# Set to autopilot to publish by itself.
# PAPERBOY_APPROVAL_MODE=approve

# Where new sites publish: wordpress, ghost, webhook, hosted or prompt. Set it per site afterwards with
# POST /api/v1/sites/{id}/publishing (see docs/self-host.md). "hosted" and "prompt" need the web app, which is not in this repo.
# PAPERBOY_PUBLISH_METHOD=wordpress

# A real Google top 10 from serper.dev for the SERP-strength gate. Without it, a web search stands in.
# SERPER_API_KEY=

# The hosted fact-check verifier (optional, needs an API key from paperboyseo.com).
# PAPERBOY_VERIFIER=hosted
# PAPERBOY_API_KEY=
# PAPERBOY_BASE_URL=https://paperboyseo.com
