# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Your own Anthropic key. The engine is tuned for Claude and uses its web search tool.
# Without it the engine can still fact check with the rule-based judge, but it cannot research or write.
ANTHROPIC_API_KEY=

# Passwords for the bundled Postgres. Pick long random values (for example: openssl rand -hex 24).
POSTGRES_PASSWORD=change-me-postgres
PAPERBOY_DB_PASSWORD=change-me-app-role

# Signs OAuth state and email links. Pick a long random value.
APP_SECRET=change-me-secret

# The operator account (the one person who logs the CLI in on a self-host).
PAPERBOY_ADMIN_EMAIL=you@example.com
PAPERBOY_ADMIN_PASSWORD=change-me-admin

# Where the server is reachable. Used in links and the Google OAuth redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------
# Search Console. Create your own Google OAuth client (Web application) and add
# ${NEXT_PUBLIC_APP_URL}/api/gsc/callback as an authorized redirect URI. Scope used: webmasters.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Report emails (https://resend.com). Without a key, emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM=Paperboy <reports@your-domain.example>

# Cost caps and pacing.
PAPERBOY_ARTICLES_PER_WEEK=3

# The hosted fact-check verifier (optional, needs an API key from paperboyseo.com).
# PAPERBOY_VERIFIER=hosted
# PAPERBOY_API_KEY=
# PAPERBOY_BASE_URL=https://paperboyseo.com
